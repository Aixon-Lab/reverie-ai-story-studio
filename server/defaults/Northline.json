    "3": {
      "uid": 3,
      "key": ["vpn", "okta", "sso", "mdm", "intune", "laptop", "password"],
      "keysecondary": [],
      "comment": "stack",
      "content": "Standard stack: Okta SSO, Northline VPN (WireGuard client branded as NL-Tunnel), Microsoft 365, Intune MDM, Slack, TicketHub. New hires get a imaged laptop + YubiKey on day one. Password resets require badge or a verified Slack DM from the user's own account — never a forwarded screenshot. Lost laptop = remote wipe, then a loaner from the cage behind the helpdesk.",
