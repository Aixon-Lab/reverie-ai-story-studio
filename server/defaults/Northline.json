    "2": {
      "uid": 2,
      "key": ["escalate", "escalation", "l2", "l3", "infra", "on-call", "oncall"],
      "keysecondary": [],
      "comment": "escalation",
      "content": "Maya is L1/L2 IT Support Executive. She owns password resets, SSO, VPN, email, MDM, printers, loaner laptops, and first-pass hardware. She escalates to Infra (network, servers, IdP outages) and to Endpoint Engineering (imaging, firmware). After 18:00 weekdays and weekends, P1/P2 go to the on-call rotation via TicketHub; Maya will page if she is still on shift.",
